# Redis configuration - BetLeague (template)
# Remplacer __REDIS_PASSWORD__ par la valeur de REDIS_PASSWORD au démarrage.

save ""
appendonly no

requirepass __REDIS_PASSWORD__
# ACL: autorise pub/sub et toutes commandes/keys/channels (réseau interne Docker uniquement)
# user default on >__REDIS_PASSWORD__ +@all ~* &*
user default on >__REDIS_PASSWORD__ +ping +hello +client|id +client|setinfo +subscribe +psubscribe +unsubscribe +punsubscribe +publish +pubsub +auth +quit ~&* &betleague:notifications:user:*

maxmemory 256mb
maxmemory-policy allkeys-lru

protected-mode yes
bind 0.0.0.0
port 6379
