# Redis configuration - BetLeague (template)
# Remplacer __REDIS_PASSWORD__ par la valeur de REDIS_PASSWORD au démarrage.

save ""
appendonly no

requirepass __REDIS_PASSWORD__

# Désactive l'utilisateur default (évite d'utiliser implicitement default en prod)
user default off

# User applicatif mutualisé:
# - notifications: channels betleague:notifications:user:*
# - reset pwd: keys betleague:pwdreset:*
# - auth JWT: keys betleague:auth:*
# - rate limit suppression compte: keys ratelimit:*
# Commandes autorisées: pub/sub + strings + Lua + ZSET strictement nécessaires à l'app
user notif on >__REDIS_PASSWORD__ +ping +hello +client|id +client|setinfo +auth +quit +publish +subscribe +psubscribe +unsubscribe +punsubscribe +pubsub +get +set +setex +del +expire +eval +evalsha +script|load +incrby +zadd +zcard +zrange +zremrangebyscore ~betleague:pwdreset:* ~betleague:notifications:user:* ~betleague:auth:* ~ratelimit:* &betleague:notifications:user:*

# User Celery: broker (lists) + result backend (strings) + keys, sur toutes les DBs
user celery on >__REDIS_PASSWORD__ +@all ~* &*

# User admin compatible avec les clients modernes
# user admin on >__REDIS_PASSWORD__ +@all +hello +client|id +client|setinfo ~* &*

maxmemory 256mb
maxmemory-policy allkeys-lru

protected-mode yes
bind 0.0.0.0
port 6379
