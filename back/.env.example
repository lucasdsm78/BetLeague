# =============================
# BetLeague backend - production / Neon example env
# =============================

# For local development, prefer `back/.env.local.example`.

# Core runtime
ENVIRONMENT=prod
# FastAPI docs (`/docs`, `/redoc`, `/openapi.json`) are automatically disabled when ENVIRONMENT=prod.
JSON_LOGS=true
LOG_SERVICE_NAME=betleague-back
SQLALCHEMY_DATABASE_URL=postgresql+asyncpg://user:password@ep-example-pooler.eu-west-1.aws.neon.tech/neondb
# Optional but recommended with Neon: use a direct compute endpoint for Alembic migrations,
# while keeping the pooled endpoint above for application runtime.
ALEMBIC_DATABASE_URL=postgresql+asyncpg://user:password@ep-example.eu-west-1.aws.neon.tech/neondb
SQLALCHEMY_SSL_MODE=verify-full
# If your PostgreSQL endpoint uses a private CA / self-signed chain, keep verify-full and
# inject the CA PEM on a single line with escaped newlines.
# SQLALCHEMY_SSL_ROOT_CERT=-----BEGIN CERTIFICATE-----\nMIIB...\n-----END CERTIFICATE-----
SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_MAX_OVERFLOW=10
SQLALCHEMY_POOL_RECYCLE=300
SQLALCHEMY_POOL_TIMEOUT=30
SQLALCHEMY_COMMAND_TIMEOUT=30
SQLALCHEMY_DISABLE_JIT=true
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=43200
SECRET_KEY_TOKEN=change-me
SECRET_KEY_TOKEN_REFRESH=change-me-too
ENCRYPTION_KEY=change-me
AUTH_REDIS_FAIL_CLOSED=true

# Frontend / CORS / proxy
APP_FRONTEND_URL=https://app.betleague.app
CORS_ALLOWED_ORIGINS=https://app.betleague.app
TRUSTED_HOSTS=api.betleague.app
TRUSTED_PROXY_IPS=10.0.0.10,10.0.0.11
# For local/direct Gunicorn runs. In Swarm production, CI/Ansible injects this explicitly.
GUNICORN_FORWARDED_ALLOW_IPS=*
HTTP_REQUEST_LOGGING_ENABLED=true
HTTP_REQUEST_LOGGING_EXCLUDED_PATHS=/health
HTTP_SLOW_REQUEST_THRESHOLD_MS=1000

# Refresh cookie
# Same-site deployment (ex: app.betleague.app <-> api.betleague.app): keep lax
# Cross-site deployment (different top-level sites): set AUTH_REFRESH_COOKIE_SAMESITE=none and AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_NAME=betleague_refresh_token
AUTH_REFRESH_COOKIE_DOMAIN=.betleague.app
AUTH_REFRESH_COOKIE_PATH=/api/auth
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE_SECURE=true

# External services (placeholders)
STRIPE_API_KEY=change-me
STRIPE_WEBHOOK_SECRET=change-me
REDIS_URL=redis://notif:change-me@redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
API_SPORTS_KEY=change-me
API_SPORTS_FOOTBALL_URL=https://v3.football.api-sports.io
# World Cup (1), UEFA Champions League (2), Premier League (39), Ligue 1 (61), Bundesliga (78), Serie A (135), La Liga (140)
API_SPORTS_LEAGUE_IDS=1,2,39,61,78,135,140
# Fetch odds for fixtures up to 3 days ahead during the daily refresh.
API_SPORTS_FETCH_ODDS_DAYS_AHEAD=3
# Cover a full busy matchday across the tracked leagues.
API_SPORTS_FETCH_ODDS_MAX_FIXTURES_PER_RUN=30
# Exceptional prefetch for the 2026 World Cup only.
API_SPORTS_WORLD_CUP_2026_ENABLED=true
API_SPORTS_WORLD_CUP_2026_FETCH_DAYS_AHEAD=60
API_SPORTS_WORLD_CUP_2026_MAX_ODDS_FIXTURES_PER_RUN=64

# League payout scheduler
# Run every 5 minutes by default so leagues are paid shortly after end_date.
CELERY_LEAGUE_PAYOUT_INTERVAL_SECONDS=300
# Prevent overlapping payout batches when one execution runs longer than the schedule interval.
CELERY_LEAGUE_PAYOUT_LOCK_KEY=betleague:celery:league_payout:lock
CELERY_LEAGUE_PAYOUT_LOCK_SECONDS=540

# League payout overdue monitoring
LEAGUE_PAYOUT_METRICS_ENABLED=true
LEAGUE_PAYOUT_METRICS_SCRAPE_INTERVAL_S=30
LEAGUE_PAYOUT_OVERDUE_THRESHOLD_MINUTES=15


