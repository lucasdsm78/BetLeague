# =============================
# BetLeague backend - example env
# =============================

# Core runtime
ENVIRONMENT=prod
SQLALCHEMY_DATABASE_URL=postgresql+asyncpg://user:password@db:5432/betleague
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=43200
SECRET_KEY_TOKEN=change-me
SECRET_KEY_TOKEN_REFRESH=change-me-too
ENCRYPTION_KEY=change-me
AUTH_REDIS_FAIL_CLOSED=true

# Frontend / CORS / proxy
APP_FRONTEND_URL=https://app.betleague.app
CORS_ALLOWED_ORIGINS=https://app.betleague.app
TRUSTED_HOSTS=api.betleague.app
TRUSTED_PROXY_IPS=10.0.0.10,10.0.0.11

# Refresh cookie
# Same-site deployment (ex: app.betleague.app <-> api.betleague.app): keep lax
# Cross-site deployment (different top-level sites): set AUTH_REFRESH_COOKIE_SAMESITE=none and AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_NAME=betleague_refresh_token
AUTH_REFRESH_COOKIE_DOMAIN=.betleague.app
AUTH_REFRESH_COOKIE_PATH=/api/auth
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE_SECURE=true

# External services (placeholders)
STRIPE_API_KEY=change-me
STRIPE_WEBHOOK_SECRET=change-me
REDIS_URL=redis://notif:change-me@redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/


