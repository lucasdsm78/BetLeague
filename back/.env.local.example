# =============================
# BetLeague backend - local development example
# =============================
# Copy this file to `back/.env` for local development.
# For production / Neon, use `back/.env.example` as the reference instead.

# Core runtime
ENVIRONMENT=dev
JSON_LOGS=false
LOG_SERVICE_NAME=betleague-back-local
SQLALCHEMY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/betleague
SQLALCHEMY_SSL_MODE=disable
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=43200
SECRET_KEY_TOKEN=change-me-local
SECRET_KEY_TOKEN_REFRESH=change-me-local-too
ENCRYPTION_KEY=change-me-local
AUTH_REDIS_FAIL_CLOSED=true
API_FOOTBALL_DATA_TOKEN=replace-me
URL_API_FOOTBALL_DATA=https://api.football-data.org/v4/matches/?status=FINISHED&date=2025-07-20
# For CI / docker --env-file compatibility, PRIVATE_KEY and PUBLIC_KEY can be injected on a single line with escaped newlines.
# Example: PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
PRIVATE_KEY=replace-me
PUBLIC_KEY=replace-me
RABBITMQ_URL=amqp://user:password@rabbitmq:5672/
STRIPE_API_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
THE_ODDS_API_API_KEY=replace-me
VAPID_PRIVATE_KEY=replace-me
VAPID_PUBLIC_KEY=replace-me
VAPID_CLAIMS_EMAIL=dev@example.com
API_SPORTS_KEY=replace-me
API_SPORTS_FOOTBALL_URL=https://v3.football.api-sports.io
# World Cup (1), UEFA Champions League (2), Premier League (39), Ligue 1 (61), Bundesliga (78), Serie A (135), La Liga (140)
API_SPORTS_LEAGUE_IDS=1,2,39,61,78,135,140
# Fetch odds for fixtures up to 3 days ahead during the daily refresh.
API_SPORTS_FETCH_ODDS_DAYS_AHEAD=3
# Cover a full busy matchday across the tracked leagues.
API_SPORTS_FETCH_ODDS_MAX_FIXTURES_PER_RUN=30
# Exceptional prefetch for the 2026 World Cup only.
API_SPORTS_WORLD_CUP_2026_ENABLED=true
API_SPORTS_WORLD_CUP_2026_FETCH_DAYS_AHEAD=60
API_SPORTS_WORLD_CUP_2026_MAX_ODDS_FIXTURES_PER_RUN=64

# Frontend / CORS / proxy
APP_FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXY_IPS=
GUNICORN_FORWARDED_ALLOW_IPS=*
HTTP_REQUEST_LOGGING_ENABLED=true
HTTP_REQUEST_LOGGING_EXCLUDED_PATHS=/health
HTTP_SLOW_REQUEST_THRESHOLD_MS=1000

# Refresh cookie
AUTH_REFRESH_COOKIE_NAME=betleague_refresh_token
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_PATH=/api/auth
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE_SECURE=false

# Local services
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_LEAGUE_PAYOUT_INTERVAL_SECONDS=300
CELERY_LEAGUE_PAYOUT_LOCK_KEY=betleague:celery:league_payout:lock
CELERY_LEAGUE_PAYOUT_LOCK_SECONDS=540
LEAGUE_PAYOUT_METRICS_ENABLED=true
LEAGUE_PAYOUT_METRICS_SCRAPE_INTERVAL_S=30
LEAGUE_PAYOUT_OVERDUE_THRESHOLD_MINUTES=15
SCHEDULER_INTERNAL_TOKEN=change-me-local-scheduler

