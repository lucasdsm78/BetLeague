#cloud-config
hostname: ${hostname}
preserve_hostname: false
package_update: true
package_upgrade: true
timezone: ${timezone}

users:
  - default
  - name: ${admin_user}
    gecos: ${admin_user}
    groups: [sudo, docker]
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
%{ if length(ssh_authorized_keys) > 0 ~}
    ssh_authorized_keys:
%{ for key in ssh_authorized_keys ~}
      - ${key}
%{ endfor ~}
%{ endif ~}

ssh_pwauth: false
disable_root: true
packages:
%{ for package in packages ~}
  - ${package}
%{ endfor ~}

write_files:
  - path: /etc/ssh/sshd_config.d/99-betleague.conf
    permissions: "0644"
    content: |
      PasswordAuthentication no
      PermitRootLogin no
      PubkeyAuthentication yes
      ChallengeResponseAuthentication no
  - path: /etc/sysctl.d/99-betleague-hardening.conf
    permissions: "0644"
    content: |
      net.ipv4.tcp_syncookies = 1
      net.ipv4.conf.all.rp_filter = 1
      net.ipv4.conf.default.rp_filter = 1
  - path: /etc/motd
    permissions: "0644"
    content: |
%{ for line in split("\n", motd) ~}
      ${line}
%{ endfor ~}

runcmd:
  - mkdir -p ${compose_root}/compose ${compose_root}/config ${compose_root}/secrets ${compose_root}/logs ${compose_root}/bin
  - chown -R ${admin_user}:${admin_user} ${compose_root}
  - systemctl enable docker
  - systemctl restart docker
  - systemctl restart ssh || systemctl restart sshd || true
  - sysctl --system
  - ufw --force reset
  - ufw default deny incoming
  - ufw default allow outgoing
%{ for port in allowed_tcp_ports ~}
  - ufw allow ${port}/tcp
%{ endfor ~}
  - ufw --force enable
%{ if enable_fail2ban ~}
  - systemctl enable fail2ban
  - systemctl restart fail2ban
%{ endif ~}
%{ for user in docker_users ~}
  - usermod -aG docker ${user}
%{ endfor ~}

final_message: "BetLeague cloud-init terminé. Hôte prêt pour le déploiement Docker Compose."

