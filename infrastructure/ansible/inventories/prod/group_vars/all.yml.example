---
betleague_admin_user: betleague
betleague_runtime_user: betleague
betleague_runtime_group: betleague
betleague_compose_root: /opt/betleague
betleague_enable_fail2ban: true
betleague_public_tcp_ports:
  - 80
  - 443
betleague_ssh_trusted_cidrs:
  - 203.0.113.10/32
betleague_unattended_origins:
  - "origin=${distro_id},codename=${distro_codename}-security,label=${distro_id}"
  - "origin=${distro_id},codename=${distro_codename}-updates,label=${distro_id}"


