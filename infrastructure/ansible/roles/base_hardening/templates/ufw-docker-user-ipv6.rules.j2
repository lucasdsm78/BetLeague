# Allow established traffic before any other decision.
-A DOCKER-USER -m conntrack --ctstate RELATED,ESTABLISHED -j RETURN

# Drop invalid packets early.
-A DOCKER-USER -m conntrack --ctstate INVALID -j DROP

# Allow internal/private IPv6 traffic (ULA, link-local, future overlay).
{% for cidr in betleague_ufw_docker_private_source_cidrs_ipv6 %}
-A DOCKER-USER -s {{ cidr }} -j RETURN
{% endfor %}

# Expose only explicitly approved public TCP ports.
{% for port in betleague_public_tcp_ports %}
-A DOCKER-USER -p tcp -m conntrack --ctstate NEW -m tcp --dport {{ port }} -j RETURN
{% endfor %}

# Log then block any other new Docker-published connection.
-A DOCKER-USER -j btl-docker-log-deny -p tcp -m conntrack --ctstate NEW
-A DOCKER-USER -j btl-docker-log-deny -p udp -m conntrack --ctstate NEW

# Do not interfere with the rest of the Docker pipeline once a decision is made.
-A DOCKER-USER -j RETURN

# Rate-limited logging to avoid flooding syslog.
-A btl-docker-log-deny -m limit --limit 3/min --limit-burst 10 -j LOG --log-prefix "{{ betleague_ufw_docker_log_prefix }}"
-A btl-docker-log-deny -j DROP


