map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

map $request_method $api_limit_key {
    default $binary_remote_addr;
    OPTIONS "";
}

map $request_method $api_conn_key {
    default $binary_remote_addr;
    OPTIONS "";
}

limit_req_zone  $api_limit_key zone=api_general:10m rate=30r/s;
limit_req_zone  $api_limit_key zone=api_auth:10m rate=20r/m;
limit_req_zone  $api_limit_key zone=api_login:10m rate=5r/m;
limit_req_zone  $api_limit_key zone=api_realtime:10m rate=10r/m;
limit_conn_zone $api_conn_key  zone=conn_limit:10m;

resolver 127.0.0.11 valid=10s ipv6=off;

map $request_method $app_method_allowed {
    default 0;
    GET     1;
    HEAD    1;
    OPTIONS 1;
}

server {
    listen 8080;
    server_name {{ betleague_swarm_app_domain }} {{ betleague_swarm_api_domain }};
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 8080 default_server;
    server_name _;
    server_tokens off;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    location / {
        return 444;
    }
}

server {
    listen 8443 ssl;
    http2 on;
    server_name {{ betleague_swarm_app_domain }};
    server_tokens off;
    set $frontend_upstream http://frontend:8080;

    client_max_body_size 1m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 15s;
    keepalive_requests 1000;
    send_timeout 15s;
    proxy_connect_timeout 5s;

    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_tickets off;
    ssl_ecdh_curve      X25519:secp384r1;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' https://{{ betleague_swarm_api_domain }}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    location / {
        if ($app_method_allowed = 0) {
            return 405;
        }

        proxy_http_version 1.1;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        proxy_next_upstream_timeout 5s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Server $host;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Connection "";
        proxy_request_buffering on;
        proxy_buffering on;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_pass $frontend_upstream;
    }
}

server {
    listen 8443 ssl;
    http2 on;
    server_name {{ betleague_swarm_api_domain }};
    server_tokens off;
    set $backend_upstream http://backend:8000;

    client_max_body_size 1m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 15s;
    keepalive_requests 1000;
    send_timeout 30s;
    proxy_connect_timeout 5s;

    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_tickets off;
    ssl_ecdh_curve      X25519:secp384r1;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    location = /api/auth/login {
        limit_req zone=api_login burst=5 nodelay;
        limit_conn conn_limit 10;

        proxy_http_version 1.1;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        proxy_next_upstream_timeout 5s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Server $host;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Connection "";
        proxy_request_buffering on;
        proxy_buffering on;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_pass $backend_upstream;
    }

    location ^~ /api/auth/ {
        limit_req zone=api_auth burst=10 nodelay;
        limit_conn conn_limit 15;

        proxy_http_version 1.1;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        proxy_next_upstream_timeout 5s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Server $host;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Connection "";
        proxy_request_buffering on;
        proxy_buffering on;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_pass $backend_upstream;
    }

    location /api/realtime/ {
        limit_req zone=api_realtime burst=5 nodelay;
        limit_conn conn_limit 5;

        proxy_http_version 1.1;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        proxy_next_upstream_timeout 5s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Server $host;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Cache-Control "no-cache";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass $backend_upstream;
    }

    location = /docs {
        return 403;
    }

    location ^~ /docs/ {
        return 403;
    }

    location = /redoc {
        return 403;
    }

    location ^~ /redoc/ {
        return 403;
    }

    location = /openapi.json {
        return 403;
    }

    location / {
        limit_req zone=api_general burst=30 nodelay;
        limit_conn conn_limit 30;

        proxy_http_version 1.1;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        proxy_next_upstream_timeout 5s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Server $host;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Connection "";
        proxy_request_buffering on;
        proxy_buffering on;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_pass $backend_upstream;
    }
}








