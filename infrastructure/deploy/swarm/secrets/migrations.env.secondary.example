# PostgreSQL secondaire OVH/VPS dédié aux migrations de secours.
# À utiliser uniquement pendant une bascule manuelle vers la base secondaire.
# Voir aussi: infrastructure/deploy/swarm/SECRETS_SECONDARY_DB.md
ALEMBIC_DATABASE_URL=postgresql+asyncpg://betleague_migrations:replace-me@pg-secondary.internal:5432/betleague
# Si l'endpoint de migrations utilise une CA privée, tu peux aussi surcharger ici :
# SQLALCHEMY_SSL_MODE=verify-full
# SQLALCHEMY_SSL_ROOT_CERT=-----BEGIN CERTIFICATE-----\nMIIB...\n-----END CERTIFICATE-----
