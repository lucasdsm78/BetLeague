ENVIRONMENT=prod
# Runtime DB fallback: PostgreSQL secondaire OVH/VPS
# Voir aussi: infrastructure/deploy/swarm/SECRETS_SECONDARY_DB.md
SQLALCHEMY_DATABASE_URL=postgresql+asyncpg://betleague_app:replace-me@pg-secondary.internal:5432/betleague
# disable si DB interne privée, verify-full si DB externe TLS avec certificat valide
SQLALCHEMY_SSL_MODE=disable
SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_MAX_OVERFLOW=10
SQLALCHEMY_POOL_RECYCLE=300
SQLALCHEMY_POOL_TIMEOUT=30
SQLALCHEMY_COMMAND_TIMEOUT=30
SQLALCHEMY_DISABLE_JIT=true
# Keep ALEMBIC_DATABASE_URL out of this file: it belongs in migrations.env only.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=43200
SECRET_KEY_TOKEN=replace-me
SECRET_KEY_TOKEN_REFRESH=replace-me-too
ENCRYPTION_KEY=replace-me
PRIVATE_KEY=replace-me
PUBLIC_KEY=replace-me
AUTH_REDIS_FAIL_CLOSED=true
APP_FRONTEND_URL=https://app.betleague.app
CORS_ALLOWED_ORIGINS=https://app.betleague.app
TRUSTED_HOSTS=api.betleague.app
INTERNAL_TRUSTED_HOSTS=backend,backend:8000,localhost,127.0.0.1
TRUSTED_PROXY_IPS=
HTTP_REQUEST_LOGGING_ENABLED=true
HTTP_REQUEST_LOGGING_EXCLUDED_PATHS=/health,/metrics
HTTP_SLOW_REQUEST_THRESHOLD_MS=1000
AUTH_REFRESH_COOKIE_NAME=betleague_refresh_token
AUTH_REFRESH_COOKIE_DOMAIN=.betleague.app
AUTH_REFRESH_COOKIE_PATH=/api/auth
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE_SECURE=true
STRIPE_API_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
REDIS_URL=redis://notif:replace-me@redis:6379/0
CELERY_BROKER_URL=redis://celery:replace-me@redis:6379/1
CELERY_RESULT_BACKEND=redis://celery:replace-me@redis:6379/2
CELERY_METRICS_QUEUES=celery
NOTIFICATIONS_REALTIME_DRIVER=redis
OUTBOX_DISPATCH_MODE=jetstream
NATS_URL=tls://nats:4222
NATS_STREAM=BETLEAGUE
NATS_SUBJECT_PREFIX=betleague
NATS_STREAM_SUBJECTS=betleague.league.>,betleague.ticket.>,betleague.match.>
NATS_DLQ_STREAM=BETLEAGUE_DLQ
NATS_DLQ_SUBJECT_PREFIX=betleague.dlq
NATS_USER=replace-me
NATS_PASSWORD=replace-me
NATS_TLS_CA=/run/secrets/ca-cert.pem
NATS_TLS_CERT=/run/secrets/client-cert.pem
NATS_TLS_KEY=/run/secrets/client-key.pem
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_MAX_POLL_INTERVAL_MS=5000
OUTBOX_JITTER_MS=150
OUTBOX_WORKER_ID=outbox_worker_1
OUTBOX_LOCK_TTL_MS=120000
NATS_PROVISIONED_STREAMS=1
NATS_DURABLE=betleague_consumer
CELERY_TIMEZONE=Europe/Paris
CELERY_ENABLE_UTC=0
CELERY_ENABLE_CATCHUP=1
CELERY_CATCHUP_THRESHOLD_SECONDS=900
CELERY_LAST_SCORE_CHECK_KEY=betleague:celery:last_check_match_scores_at
