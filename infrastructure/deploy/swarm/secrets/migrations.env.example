# Direct Neon endpoint dedicated to Alembic migrations / DDL.
# Keep this secret separate from backend.env so runtime services never see DDL credentials.
# This file may also override SQLALCHEMY_SSL_MODE / SQLALCHEMY_SSL_ROOT_CERT for migrations only
# when the direct PostgreSQL endpoint uses a private CA or a self-signed certificate chain.
ALEMBIC_DATABASE_URL=postgresql+asyncpg://user:password@ep-example.eu-west-1.aws.neon.tech/neondb
# SQLALCHEMY_SSL_MODE=verify-full
# SQLALCHEMY_SSL_ROOT_CERT=-----BEGIN CERTIFICATE-----\nMIIB...\n-----END CERTIFICATE-----

